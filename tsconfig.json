{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": ["google-apps-script", "chrome", "vitest/globals"],
    "skipLibCheck": true
  },
  "include": ["src", "scripts", "preview"]
}
